<form class="card" autocomplete="off">
    <input type="hidden" name="category[id]" value="<?= $category->getId(); ?>" />

    <div class="card-body">
        <div class="row mb-3">
            <label class="col-lg-2 col-form-label"><?= $this->translate('Name'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <input type="text" name="category[name]" class="form-control" placeholder="<?= $this->translate('Category name'); ?>" value="<?= $category->getName(); ?>" />
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>

        <?php if ($extendedMode): ?>
        <div class="row mb-3">
            <label class="col-lg-2 col-form-label"><?= $this->translate('Class'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <input type="text" name="category[class]" class="form-control" placeholder="<?= $this->translate('Class to simplify rendering'); ?>" value="<?= $category->getClass(); ?>" />
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>
        <?php else: ?>
        <input type="hidden" name="category[class]" value="<?= $category->getClass(); ?>" />
        <?php endif; ?>

        <div class="row mb-4">
            <label class="col-lg-2 col-form-label"><?= $this->translate('Maximal depth'); ?></label>
            <div class="col-lg-10">
                <div class="input-group">
                    <input type="number" name="category[max_depth]" class="form-control" placeholder="<?= $this->translate('Maximal allowed nested level for items'); ?>" value="<?= $category->getMaxDepth(); ?>" />
                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                </div>
            </div>
        </div>

        <div class="border-top pt-3">
            <?php if ($category->getId()): ?>
            <button type="submit" data-button="save" data-url="<?= $this->url('Menu:Admin:Category@saveAction'); ?>" class="btn btn-primary">
                <i class="bi bi-check-circle"></i> <?= $this->translate('Save'); ?>
            </button>
            <?php else: ?>
            <button type="submit" data-button="add" data-back-url="<?= $this->url('Menu:Admin:Category@editAction', null); ?>" data-url="<?= $this->url('Menu:Admin:Category@saveAction'); ?>" class="btn btn-success">
                <i class="bi bi-plus-circle"></i> <?= $this->translate('Add'); ?>
            </button>
            <?php endif; ?>

            <button type="button" data-button="cancel" data-url="<?= $this->url('Menu:Admin:Item@indexAction'); ?>" class="btn btn-outline-secondary">
                <i class="bi bi-x-circle"></i> <?= $this->translate('Cancel'); ?>
            </button>
        </div>
    </div>
</form>